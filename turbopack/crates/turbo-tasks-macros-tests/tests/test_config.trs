|_name, _initial| {
  turbo_tasks::TurboTasks::new(
    turbo_tasks_backend::TurboTasksBackend::new(
      turbo_tasks_backend::BackendOptions {
        num_workers: Some(2),
        small_preallocation: true,
        storage_mode: Some(turbo_tasks_backend::StorageMode::ReadWriteOnShutdown),
        ..Default::default()
      },
      // Wrapped via `prod_backing_storage_noop` to match
      // `ProdBackingStorage` — see the rationale in
      // `turbo-tasks-backend/tests/test_config.trs`.
      turbo_tasks_backend::prod_backing_storage_noop(turbo_tasks_backend::noop_backing_storage()),
    )
  )
}
